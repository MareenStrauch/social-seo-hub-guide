# --- Claude / Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional: guenstigeres Modell fuer hohes Volumen. Default: claude-opus-5
CLAUDE_MODEL=claude-opus-5

# --- WhatsApp Business Platform (Meta Cloud API) ---
# Aus dem Meta Developer Dashboard (App -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Frei waehlbares Geheimwort; muss beim Webhook-Setup in Meta identisch eingetragen werden
WHATSAPP_VERIFY_TOKEN=ein-langes-zufaelliges-geheimwort
# Graph-API-Version (bei Bedarf anpassen)
GRAPH_API_VERSION=v21.0

# --- Betreiber (du) ---
# WhatsApp-Nummer im Format 4915112345678 (ohne + und ohne fuehrende 00),
# die eine Kopie jeder freigegebenen Anzeige bekommt, damit du sie in
# AnzeigenChef eintraegst. Optional.
OPERATOR_WHATSAPP=4915112345678

# --- Server ---
PORT=3000
